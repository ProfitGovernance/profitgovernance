const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="it">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />

		<title>Profit Governance | Strategia, controllo e redditività</title>

		<meta
			name="description"
			content="Profit Governance integra Revenue Management, Controllo di Gestione e Profit Management per supportare decisioni orientate alla redditività."
		/>
	</head>

	<body>
		<header class="header">
			<a class="brand" href="#home" aria-label="Profit Governance">
				<span class="brand-mark">PG</span>
				<span>Profit Governance</span>
			</a>

			<nav class="navigation" aria-label="Menu principale">
				<a href="#metodo">Il metodo</a>
				<a href="#quoprofit">QuoProfit</a>
				<a href="#brevetto">Tecnologia</a>
				<a href="#contatti">Contatti</a>
			</nav>

			<a
  class="button button-small"
  href="#richiesta-demo"
>
  Richiedi una demo
</a>
		</header>

		<main>
			<section class="hero" id="home">
				<div class="hero-content">
					<p class="eyebrow">Strategia economica per l'ospitalità</p>

					<h1>
						Dal Revenue Management alla
						<span>Profit Governance</span>
					</h1>

<p>
  Il primo sistema di Profit Management <strong>BREVETTATO</strong>.<br>
  Un modello evoluto che integra prezzi, costi, marginalità e<br>
  risultati economici per guidare la struttura ricettiva verso un<br>
  profitto più consapevole e sostenibile.
</p>

					<div class="hero-actions">
						<a
  class="button"
  href="#richiesta-demo"
>
  Richiedi una demo
</a>
						<a class="button button-secondary" href="#metodo">
							Scopri il metodo
						</a>
					</div>

					<div class="trust">
						<span>Controllo di Gestione</span>
						<span>Revenue Management</span>
						<span>Profit Management</span>
					</div>
				</div>

				<div class="hero-panel" aria-label="Percorso Profit Governance">
					<div class="panel-label">Il percorso strategico</div>

					<div class="flow-item">
						<span class="flow-number">01</span>
						<div>
							<strong>Revenue Management</strong>
							<p>Ottimizzazione dinamica di prezzi e domanda.</p>
						</div>
					</div>

					<div class="flow-line"></div>

					<div class="flow-item">
						<span class="flow-number">02</span>
						<div>
							<strong>Controllo di Gestione</strong>
							<p>Analisi di costi, marginalità e sostenibilità.</p>
						</div>
					</div>

					<div class="flow-line"></div>

					<div class="flow-item">
						<span class="flow-number">03</span>
						<div>
							<strong>Profit Management</strong>
							<p>Decisioni orientate al risultato economico.</p>
						</div>
					</div>

					<div class="flow-line"></div>

					<div class="flow-item flow-highlight">
						<span class="flow-number">04</span>
						<div>
							<strong>Profit Governance</strong>
							<p>Visione, controllo e governo della redditività.</p>
						</div>
					</div>
				</div>
			</section>

			<section class="section" id="metodo">
				<div class="section-heading">
					<p class="eyebrow">Un approccio integrato</p>
					<h2>Il fatturato non basta. Serve governare il profitto.</h2>
					<p>
						Le decisioni di prezzo acquistano valore solo quando vengono
						collegate ai costi, alla marginalità e agli obiettivi economici
						della struttura.
					</p>
				</div>

				<div class="cards">
					<article class="card">
						<span>01</span>
						<h3>Misurare</h3>
						<p>
							Organizzare dati economici, operativi e commerciali in una
							visione comune.
						</p>
					</article>

					<article class="card">
						<span>02</span>
						<h3>Simulare</h3>
						<p>
							Valutare in anticipo l'impatto di prezzi, occupazione, ricavi e
							costi.
						</p>
					</article>

					<article class="card">
						<span>03</span>
						<h3>Decidere</h3>
						<p>
							Trasformare l'analisi in azioni concrete orientate alla
							redditività.
						</p>
					</article>
				</div>
			</section>

			<section class="section section-dark" id="quoprofit">
				<div class="split">
					<div>
						<p class="eyebrow eyebrow-light">La piattaforma</p>
						<h2>QuoProfit integra strategia e controllo economico.</h2>
					</div>

					<div>
						<p>
							QuoProfit supporta le strutture ricettive nell'analisi dei
							ricavi, dei costi, della marginalità e delle strategie di prezzo,
							restituendo una visione completa dell'andamento aziendale.
						</p>

						<a class="text-link" href="#contatti">Scopri QuoProfit →</a>
					</div>
				</div>
			</section>

			<section class="section" id="brevetto">
				<div class="patent">
					<div class="patent-icon">✓</div>

					<div>
						<p class="eyebrow">Innovazione</p>
						<h2>Tecnologia supportata da metodologia brevettata</h2>
						<p>
							Un'architettura sviluppata per collegare analisi, simulazione e
							decisione economica in un processo strutturato e verificabile.
						</p>
					</div>
				</div>
			</section>

			<section class="demo-section" id="richiesta-demo">
				<div class="demo-intro">
					<p class="eyebrow">Richiedi una demo</p>
					<h2>
  Richiedi una DEMO.<br>
  E' il tuo momento!
</h2>
					<p>
						Compila il modulo in tutte le sue parti di  modo che si possa preparare una demo e presentazione perfettamente aderente alle caratteristiche della tua Struttura Ricettiva.
					</p>
				</div>

				<div class="demo-layout">
					<form
						id="demo-form"
						class="demo-form"
						action="https://formspree.io/f/meeyazad"
						method="POST"
					>
						<input
							type="hidden"
							name="_subject"
							value="Nuova richiesta demo dal sito Profit Governance"
						/>

						<div class="form-grid">
							<label>
								<span>Tipo struttura *</span>
								<select name="Tipo struttura" required>
									<option value="">Seleziona</option>
									<option>Hotel</option>
									<option>Resort</option>
									<option>Residence</option>
									<option>Villaggio Turistico</option>
									<option>Campeggio</option>
									<option>Glamping</option>
									<option>Agriturismo</option>
									<option>B&B</option>
									<option>Affittacamere</option>
									<option>Casa Vacanze</option>
									<option>Appartamenti Turistici</option>
									<option>Ostello</option>
									<option>Altro</option>
								</select>
							</label>

							<label>
								<span>Nome struttura *</span>
								<input type="text" name="Nome struttura" required />
							</label>

							<label>
								<span>Località *</span>
								<input type="text" name="Località" required />
							</label>

							<label>
								<span>Numero totale unità abitative *</span>
								<input
									type="number"
									name="Numero totale unità abitative"
									min="1"
									required
								/>
							</label>

							<label>
								<span>Nome referente *</span>
								<input type="text" name="Nome referente" required />
							</label>

							<label>
								<span>Telefono *</span>
								<input type="tel" name="Telefono" required />
							</label>

							<label>
								<span>Email *</span>
								<input type="email" name="Email" required />
							</label>

							<label>
								<span>PMS utilizzato *</span>
								<select name="PMS utilizzato" required>
									<option value="">Seleziona</option>
									<option>Passepartout</option>
									<option>Ericsoft</option>
									<option>Scrigno</option>
									<option>Scidoo</option>
									<option>QuoVai</option>
									<option>5 Stelle</option>
									<option>Protel</option>
									<option>Leonardo</option>
									<option>Oracle OPERA</option>
									<option>Mews</option>
									<option>Cloudbeds</option>
									<option>RoomRaccoon</option>
									<option>Hotel in Cloud</option>
									<option>Nessun PMS</option>
									<option>Altro</option>
								</select>
							</label>

							<label>
								<span>Channel Manager utilizzato *</span>
								<select name="Channel Manager utilizzato" required>
									<option value="">Seleziona</option>
									<option>Simple Booking</option>
									<option>Vertical Booking</option>
									<option>SiteMinder</option>
									<option>Octorate</option>
									<option>WuBook</option>
									<option>D-EDGE</option>
									<option>Hotel Spider</option>
									<option>Cubilis</option>
									<option>RateGain</option>
									<option>Bookassist</option>
									<option>QuoVai</option>
									<option>Nessun Channel Manager</option>
									<option>Altro</option>
								</select>
							</label>

							<label>
								<span>Ti interessa il Controllo di Gestione? *</span>
								<select name="Interesse Controllo di Gestione" required>
									<option value="">Seleziona</option>
									<option>Sì</option>
									<option>No</option>
									<option>Vorrei saperne di più</option>
								</select>
							</label>

							<label>
								<span>Come ci hai conosciuto? *</span>
								<select id="conoscenza" name="Come ci hai conosciuto" required>
									<option value="">Seleziona</option>
									<option>Google</option>
									<option>LinkedIn</option>
									<option>Facebook</option>
									<option>Instagram</option>
									<option>Passaparola</option>
									<option>Cliente QuoProfit</option>
									<option>BNI</option>
									<option>Aristide T.</option>
									<option>Franco Z.</option>
									<option>Fiera</option>
									<option>Webinar</option>
									<option>Associazione di categoria</option>
									<option>Articolo o blog</option>
									<option>YouTube</option>
									<option>Altro</option>
								</select>
							</label>

							<label id="capitolo-bni-field" class="conditional-field">
								<span>Capitolo BNI</span>
								<input type="text" name="Capitolo BNI" />
							</label>

							<label id="altro-conoscenza-field" class="conditional-field">
								<span>Specifica come ci hai conosciuto</span>
								<input type="text" name="Altro - Come ci hai conosciuto" />
							</label>

							<label class="form-full">
								<span>Messaggio</span>
								<textarea
									name="Messaggio"
									rows="5"
									placeholder="Descrivi brevemente le tue esigenze o gli aspetti che vorresti approfondire."
								></textarea>
							</label>
						</div>

						<label class="privacy-row">
							<input type="checkbox" name="Consenso privacy" value="Accettato" required />
							<span>
								Acconsento al trattamento dei dati forniti esclusivamente per
								gestire la richiesta di contatto e demo. *
							</span>
						</label>

						<button class="button demo-submit" type="submit">
							Invia richiesta
						</button>

						<p id="form-status" class="form-status" aria-live="polite"></p>
					</form>

					<aside class="demo-side">
						<p class="eyebrow eyebrow-light"> COSA SUCCEDE DOPO che hai inviato la richiesta della DEMO?</p>
						<h3>Una demo costruita sui tuoi dati e sulle tue priorità.</h3>

						<div class="demo-step">
							<span>01</span>
							<p>Riceviamo e analizziamo le informazioni della struttura.</p>
						</div>

						<div class="demo-step">
							<span>02</span>
							<p>Scegli la data e l'orario disponibili nel calendario.</p>
						</div>

						<div class="demo-step">
							<span>03</span>
							<p>Approfondiamo insieme Revenue, costi e redditività.</p>
						</div>

						<div id="calendar-box" class="calendar-box" hidden>
							<strong>Richiesta ricevuta correttamente.</strong>
							<p>Ora puoi scegliere direttamente la data della demo.</p>
							<a
								class="button button-light"
								href="https://calendar.app.google/215FfuoWEndYFCNT6"
								target="_blank"
								rel="noopener noreferrer"
							>
								Prenota la tua demo
							</a>
						</div>
					</aside>
				</div>
			</section>

			<section class="cta" id="contatti">
				<div>
					<p class="eyebrow eyebrow-light">Profit Governance</p>
					<h2>Scopri come trasformare i dati in decisioni più redditizie.</h2>
				</div>

				<a class="button button-light" href="#richiesta-demo">
					Richiedi una demo
				</a>
			</section>
		</main>

		<footer>
			<p>© {currentYear} Profit Governance. Tutti i diritti riservati.</p>
			<p>Una soluzione per il governo della redditività.</p>
		</footer>

		<script is:inline>
			const form = document.getElementById("demo-form");
			const status = document.getElementById("form-status");
			const calendarBox = document.getElementById("calendar-box");
			const conoscenza = document.getElementById("conoscenza");
			const bniField = document.getElementById("capitolo-bni-field");
			const altroField = document.getElementById("altro-conoscenza-field");

			function aggiornaCampiCondizionali() {
				const value = conoscenza.value;

				bniField.classList.toggle("is-visible", value === "BNI");
				altroField.classList.toggle("is-visible", value === "Altro");

				const bniInput = bniField.querySelector("input");
				const altroInput = altroField.querySelector("input");

				bniInput.required = value === "BNI";
				altroInput.required = value === "Altro";

				if (value !== "BNI") bniInput.value = "";
				if (value !== "Altro") altroInput.value = "";
			}

			conoscenza.addEventListener("change", aggiornaCampiCondizionali);

			form.addEventListener("submit", async (event) => {
				event.preventDefault();

				const button = form.querySelector('button[type="submit"]');
				const originalText = button.textContent;

				button.disabled = true;
				button.textContent = "Invio in corso…";
				status.textContent = "";
				status.className = "form-status";

				try {
					const response = await fetch(form.action, {
						method: "POST",
						body: new FormData(form),
						headers: {
							Accept: "application/json"
						}
					});

					if (!response.ok) {
						throw new Error("Invio non riuscito");
					}

					form.reset();
					aggiornaCampiCondizionali();
					status.textContent =
						status.textContent =
status.textContent =
	"✅ Richiesta inviata correttamente! ➡️ Ora clicca sul pulsante 'Prenota la tua Demo' qui a destra per scegliere data e orario.";
					status.classList.add("success");
					calendarBox.hidden = false; 
				} catch (error) {
					status.textContent =
						"Non è stato possibile inviare la richiesta. Riprova tra poco.";
					status.classList.add("error");
				} finally {
					button.disabled = false;
					button.textContent = originalText;
				}
			});
		</script>
	</body>
</html>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(html) {
		scroll-behavior: smooth;
	}

	:global(body) {
		margin: 0;
		background: #f5f7f9;
		color: #17222c;
		font-family:
			Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
			"Segoe UI", sans-serif;
	}

	:global(a) {
		color: inherit;
		text-decoration: none;
	}

	.header {
		position: sticky;
		top: 0;
		z-index: 20;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 32px;
		padding: 20px clamp(24px, 6vw, 96px);
		background: rgba(245, 247, 249, 0.92);
		border-bottom: 1px solid rgba(23, 34, 44, 0.08);
		backdrop-filter: blur(14px);
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 12px;
		font-size: 18px;
		font-weight: 750;
	}

	.brand-mark {
		display: grid;
		width: 42px;
		height: 42px;
		place-items: center;
		border-radius: 12px;
		background: #007e94;
		color: #fff;
		font-size: 14px;
		letter-spacing: 0.08em;
	}

	.navigation {
		display: flex;
		gap: 30px;
		color: #53616c;
		font-size: 15px;
	}

	.navigation a:hover {
		color: #007e94;
	}

	.button {
		display: inline-flex;
		min-height: 52px;
		align-items: center;
		justify-content: center;
		padding: 0 25px;
		border: 1px solid #007e94;
		border-radius: 999px;
		background: #007e94;
		color: white;
		font-weight: 700;
		transition:
			transform 0.2s ease,
			background 0.2s ease;
	}

	.button:hover {
		transform: translateY(-2px);
		background: #006b7e;
	}

	.button-small {
		min-height: 44px;
		padding-inline: 20px;
		font-size: 14px;
	}

	.button-secondary {
		background: transparent;
		color: #17222c;
		border-color: #c9d2d8;
	}

	.button-secondary:hover {
		background: #fff;
	}

	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1.2fr) minmax(340px, 0.8fr);
		gap: clamp(50px, 8vw, 120px);
		align-items: center;
		min-height: calc(100vh - 85px);
		padding: 90px clamp(24px, 7vw, 120px);
		background:
			radial-gradient(circle at 10% 10%, rgba(0, 126, 148, 0.12), transparent 34%),
			linear-gradient(135deg, #f8fafb, #eef3f5);
	}

	.hero-content {
		max-width: 820px;
	}

	.eyebrow {
		margin: 0 0 20px;
		color: #007e94;
		font-size: 13px;
		font-weight: 800;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	h1,
	h2,
	h3,
	p {
		margin-top: 0;
	}

	h1 {
		margin-bottom: 28px;
		font-size: clamp(48px, 7vw, 92px);
		line-height: 0.98;
		letter-spacing: -0.055em;
	}

	h1 span {
		display: block;
		color: #007e94;
	}

	.hero-description {
		max-width: 710px;
		margin-bottom: 34px;
		color: #52616c;
		font-size: clamp(18px, 2vw, 22px);
		line-height: 1.65;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
	}

	.trust {
		display: flex;
		flex-wrap: wrap;
		gap: 24px;
		margin-top: 45px;
		color: #6a7882;
		font-size: 13px;
		font-weight: 650;
	}

	.trust span::before {
		margin-right: 8px;
		color: #007e94;
		content: "✓";
	}

	.hero-panel {
		padding: clamp(28px, 4vw, 46px);
		border: 1px solid rgba(255, 255, 255, 0.75);
		border-radius: 28px;
		background: rgba(255, 255, 255, 0.78);
		box-shadow: 0 30px 80px rgba(26, 49, 60, 0.13);
		backdrop-filter: blur(16px);
	}

	.panel-label {
		margin-bottom: 30px;
		color: #71808a;
		font-size: 12px;
		font-weight: 800;
		letter-spacing: 0.15em;
		text-transform: uppercase;
