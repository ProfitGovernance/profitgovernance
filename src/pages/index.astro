	}

	.section {
		padding: 110px clamp(24px, 7vw, 120px);
	}

	.section-heading {
		max-width: 850px;
		margin-bottom: 60px;
	}

	h2 {
		margin-bottom: 24px;
		font-size: clamp(38px, 5vw, 64px);
		line-height: 1.05;
		letter-spacing: -0.045em;
	}

	.section-heading > p:last-child,
	.split p,
	.patent p {
		color: #60707b;
		font-size: 18px;
		line-height: 1.7;
	}

	.cards {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 22px;
	}

	.card {
		min-height: 290px;
		padding: 34px;
		border: 1px solid #dce3e7;
		border-radius: 24px;
		background: white;
	}

	.card span {
		color: #007e94;
		font-size: 13px;
		font-weight: 800;
	}

	.card h3 {
		margin: 65px 0 16px;
		font-size: 27px;
