---
const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="it">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />

		<title>Profit Governance | Strategia, controllo e redditività</title>

		<meta
			name="description"
			content="Profit Governance integra Revenue Management, Controllo di Gestione e Profit Management per supportare decisioni orientate alla redditività."
		/>
	</head>

	<body>
		<header class="header">
			<a class="brand" href="#home" aria-label="Profit Governance">
				<span class="brand-mark">PG</span>
				<span>Profit Governance</span>
			</a>

			<nav class="navigation" aria-label="Menu principale">
				<a href="#metodo">Il metodo</a>
				<a href="#quoprofit">QuoProfit</a>
				<a href="#brevetto">Tecnologia</a>
				<a href="#contatti">Contatti</a>
			</nav>

			<a
  class="button button-small"
  href="mailto:quoprofit@gmail.com?subject=Richiesta%20Demo%20Profit%20Governance"
>
  Richiedi una demo
</a>
		</header>

		<main>
			<section class="hero" id="home">
				<div class="hero-content">
					<p class="eyebrow">Strategia economica per l'ospitalità</p>

					<h1>
						Dal Revenue Management alla
						<span>Profit Governance</span>
					</h1>

					<p class="hero-description">
						Un modello evoluto che integra prezzi, costi, marginalità e
						risultati economici per guidare la struttura ricettiva verso un
						profitto più consapevole e sostenibile.
					</p>

					<div class="hero-actions">
						<a
  class="button"
  href="mailto:quoprofit@gmail.com?subject=Richiesta%20Demo%20Profit%20Governance"
>
  Richiedi una demo
</a>
						<a class="button button-secondary" href="#metodo">
							Scopri il metodo
						</a>
					</div>

					<div class="trust">
						<span>Controllo di Gestione</span>
						<span>Revenue Management</span>
						<span>Profit Management</span>
					</div>
				</div>

				<div class="hero-panel" aria-label="Percorso Profit Governance">
					<div class="panel-label">Il percorso strategico</div>

					<div class="flow-item">
						<span class="flow-number">01</span>
						<div>
							<strong>Revenue Management</strong>
							<p>Ottimizzazione dinamica di prezzi e domanda.</p>
						</div>
					</div>

					<div class="flow-line"></div>

					<div class="flow-item">
						<span class="flow-number">02</span>
						<div>
							<strong>Controllo di Gestione</strong>
							<p>Analisi di costi, marginalità e sostenibilità.</p>
						</div>
					</div>

					<div class="flow-line"></div>

					<div class="flow-item">
						<span class="flow-number">03</span>
						<div>
							<strong>Profit Management</strong>
							<p>Decisioni orientate al risultato economico.</p>
						</div>
					</div>

					<div class="flow-line"></div>

					<div class="flow-item flow-highlight">
						<span class="flow-number">04</span>
						<div>
							<strong>Profit Governance</strong>
							<p>Visione, controllo e governo della redditività.</p>
						</div>
					</div>
				</div>
			</section>

			<section class="section" id="metodo">
				<div class="section-heading">
					<p class="eyebrow">Un approccio integrato</p>
					<h2>Il fatturato non basta. Serve governare il profitto.</h2>
					<p>
						Le decisioni di prezzo acquistano valore solo quando vengono
						collegate ai costi, alla marginalità e agli obiettivi economici
						della struttura.
					</p>
				</div>

				<div class="cards">
					<article class="card">
						<span>01</span>
						<h3>Misurare</h3>
						<p>
							Organizzare dati economici, operativi e commerciali in una
							visione comune.
						</p>
					</article>

					<article class="card">
						<span>02</span>
						<h3>Simulare</h3>
						<p>
							Valutare in anticipo l'impatto di prezzi, occupazione, ricavi e
							costi.
						</p>
					</article>

					<article class="card">
						<span>03</span>
						<h3>Decidere</h3>
						<p>
							Trasformare l'analisi in azioni concrete orientate alla
							redditività.
						</p>
					</article>
				</div>
			</section>

			<section class="section section-dark" id="quoprofit">
				<div class="split">
					<div>
						<p class="eyebrow eyebrow-light">La piattaforma</p>
						<h2>QuoProfit integra strategia e controllo economico.</h2>
					</div>

					<div>
						<p>
							QuoProfit supporta le strutture ricettive nell'analisi dei
							ricavi, dei costi, della marginalità e delle strategie di prezzo,
							restituendo una visione completa dell'andamento aziendale.
						</p>

						<a class="text-link" href="#contatti">Scopri QuoProfit →</a>
					</div>
				</div>
			</section>

			<section class="section" id="brevetto">
				<div class="patent">
					<div class="patent-icon">✓</div>

					<div>
						<p class="eyebrow">Innovazione</p>
						<h2>Tecnologia supportata da metodologia brevettata</h2>
						<p>
							Un'architettura sviluppata per collegare analisi, simulazione e
							decisione economica in un processo strutturato e verificabile.
						</p>
					</div>
				</div>
			</section>

			<section class="cta" id="contatti">
				<div>
					<p class="eyebrow eyebrow-light">Parliamo della tua struttura</p>
					<h2>Scopri come trasformare i dati in decisioni più redditizie.</h2>
				</div>

				<a
					class="button button-light"
					href="mailto:quoprofit@gmail.com?subject=Richiesta%20demo%20Profit%20Governance"
				>
					Richiedi una demo
				</a>
			</section>
		</main>

		<footer>
			<p>© {currentYear} Profit Governance. Tutti i diritti riservati.</p>
			<p>Una soluzione per il governo della redditività.</p>
		</footer>
	</body>
</html>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(html) {
		scroll-behavior: smooth;
	}

	:global(body) {
		margin: 0;
		background: #f5f7f9;
		color: #17222c;
		font-family:
			Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
			"Segoe UI", sans-serif;
	}

	:global(a) {
		color: inherit;
		text-decoration: none;
	}

	.header {
		position: sticky;
		top: 0;
		z-index: 20;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 32px;
		padding: 20px clamp(24px, 6vw, 96px);
		background: rgba(245, 247, 249, 0.92);
		border-bottom: 1px solid rgba(23, 34, 44, 0.08);
		backdrop-filter: blur(14px);
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 12px;
		font-size: 18px;
		font-weight: 750;
	}

	.brand-mark {
		display: grid;
		width: 42px;
		height: 42px;
		place-items: center;
		border-radius: 12px;
		background: #007e94;
		color: #fff;
		font-size: 14px;
		letter-spacing: 0.08em;
	}

	.navigation {
		display: flex;
		gap: 30px;
		color: #53616c;
		font-size: 15px;
	}

	.navigation a:hover {
		color: #007e94;
	}

	.button {
		display: inline-flex;
		min-height: 52px;
		align-items: center;
		justify-content: center;
		padding: 0 25px;
		border: 1px solid #007e94;
		border-radius: 999px;
		background: #007e94;
		color: white;
		font-weight: 700;
		transition:
			transform 0.2s ease,
			background 0.2s ease;
	}

	.button:hover {
		transform: translateY(-2px);
		background: #006b7e;
	}

	.button-small {
		min-height: 44px;
		padding-inline: 20px;
		font-size: 14px;
	}

	.button-secondary {
		background: transparent;
		color: #17222c;
		border-color: #c9d2d8;
	}

	.button-secondary:hover {
		background: #fff;
	}

	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1.2fr) minmax(340px, 0.8fr);
		gap: clamp(50px, 8vw, 120px);
		align-items: center;
		min-height: calc(100vh - 85px);
		padding: 90px clamp(24px, 7vw, 120px);
		background:
			radial-gradient(circle at 10% 10%, rgba(0, 126, 148, 0.12), transparent 34%),
			linear-gradient(135deg, #f8fafb, #eef3f5);
	}

	.hero-content {
		max-width: 820px;
	}

	.eyebrow {
		margin: 0 0 20px;
		color: #007e94;
		font-size: 13px;
		font-weight: 800;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	h1,
	h2,
	h3,
	p {
		margin-top: 0;
	}

	h1 {
		margin-bottom: 28px;
		font-size: clamp(48px, 7vw, 92px);
		line-height: 0.98;
		letter-spacing: -0.055em;
	}

	h1 span {
		display: block;
		color: #007e94;
	}

	.hero-description {
		max-width: 710px;
		margin-bottom: 34px;
		color: #52616c;
		font-size: clamp(18px, 2vw, 22px);
		line-height: 1.65;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
	}

	.trust {
		display: flex;
		flex-wrap: wrap;
		gap: 24px;
		margin-top: 45px;
		color: #6a7882;
		font-size: 13px;
		font-weight: 650;
	}

	.trust span::before {
		margin-right: 8px;
		color: #007e94;
		content: "✓";
	}

	.hero-panel {
		padding: clamp(28px, 4vw, 46px);
		border: 1px solid rgba(255, 255, 255, 0.75);
		border-radius: 28px;
		background: rgba(255, 255, 255, 0.78);
		box-shadow: 0 30px 80px rgba(26, 49, 60, 0.13);
		backdrop-filter: blur(16px);
	}

	.panel-label {
		margin-bottom: 30px;
		color: #71808a;
		font-size: 12px;
		font-weight: 800;
		letter-spacing: 0.15em;
		text-transform: uppercase;
	}

	.flow-item {
		display: grid;
		grid-template-columns: 52px 1fr;
		gap: 18px;
		align-items: flex-start;
	}

	.flow-number {
		display: grid;
		width: 52px;
		height: 52px;
		place-items: center;
		border: 1px solid #d7e0e5;
		border-radius: 15px;
		color: #007e94;
		font-weight: 800;
	}

	.flow-item strong {
		display: block;
		margin-bottom: 7px;
		font-size: 18px;
	}

	.flow-item p {
		margin-bottom: 0;
		color: #697781;
		font-size: 14px;
		line-height: 1.5;
	}

	.flow-line {
		width: 1px;
		height: 27px;
		margin: 7px 0 7px 25px;
		background: #d9e2e6;
	}

	.flow-highlight {
		padding: 18px;
		margin: 0 -18px -18px;
		border-radius: 20px;
		background: #0a7e93;
		color: #fff;
	}

	.flow-highlight .flow-number {
		border-color: rgba(255, 255, 255, 0.35);
		color: white;
	}

	.flow-highlight p {
		color: rgba(255, 255, 255, 0.78);
	}

	.section {
		padding: 110px clamp(24px, 7vw, 120px);
	}

	.section-heading {
		max-width: 850px;
		margin-bottom: 60px;
	}

	h2 {
		margin-bottom: 24px;
		font-size: clamp(38px, 5vw, 64px);
		line-height: 1.05;
		letter-spacing: -0.045em;
	}

	.section-heading > p:last-child,
	.split p,
	.patent p {
		color: #60707b;
		font-size: 18px;
		line-height: 1.7;
	}

	.cards {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 22px;
	}

	.card {
		min-height: 290px;
		padding: 34px;
		border: 1px solid #dce3e7;
		border-radius: 24px;
		background: white;
	}

	.card span {
		color: #007e94;
		font-size: 13px;
		font-weight: 800;
	}

	.card h3 {
		margin: 65px 0 16px;
		font-size: 27px;
	}

	.card p {
		color: #65747e;
		line-height: 1.65;
	}

	.section-dark {
		background: #122530;
		color: white;
	}

	.split {
		display: grid;
		grid-template-columns: 1fr 0.8fr;
		gap: clamp(50px, 10vw, 150px);
		align-items: start;
	}

	.split p {
		color: #b9c4ca;
	}

	.eyebrow-light {
		color: #6ed4e4;
	}

	.text-link {
		display: inline-block;
		margin-top: 12px;
		color: #6ed4e4;
		font-weight: 750;
	}

	.patent {
		display: grid;
		grid-template-columns: 100px 1fr;
		gap: 40px;
		align-items: flex-start;
		max-width: 1000px;
	}

	.patent-icon {
		display: grid;
		width: 100px;
		height: 100px;
		place-items: center;
		border-radius: 28px;
		background: #dceff2;
		color: #007e94;
		font-size: 38px;
		font-weight: 900;
	}

	.cta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 50px;
		padding: 90px clamp(24px, 7vw, 120px);
		background: #007e94;
		color: white;
	}

	.cta h2 {
		max-width: 900px;
		margin-bottom: 0;
	}

	.button-light {
		flex: 0 0 auto;
		border-color: white;
		background: white;
		color: #007e94;
	}

	.button-light:hover {
		background: #eef8fa;
	}

	footer {
		display: flex;
		justify-content: space-between;
		gap: 30px;
		padding: 34px clamp(24px, 7vw, 120px);
		background: #0d1e27;
		color: #98a7b0;
		font-size: 13px;
	}

	footer p {
		margin: 0;
	}

	@media (max-width: 980px) {
		.navigation,
		.header > .button {
			display: none;
		}

		.hero,
		.split {
			grid-template-columns: 1fr;
		}

		.hero {
			min-height: auto;
		}

		.cards {
			grid-template-columns: 1fr;
		}

		.card {
			min-height: auto;
		}

		.cta {
			align-items: flex-start;
			flex-direction: column;
		}
	}

	@media (max-width: 640px) {
		.header {
			padding: 16px 20px;
		}

		.hero,
		.section,
		.cta {
			padding: 70px 22px;
		}

		h1 {
			font-size: 50px;
		}

		.hero-actions {
			flex-direction: column;
		}

		.button {
			width: 100%;
		}

		.patent {
			grid-template-columns: 1fr;
		}

		.patent-icon {
			width: 75px;
			height: 75px;
		}

		footer {
			flex-direction: column;
			padding: 30px 22px;
		}
	}
</style>